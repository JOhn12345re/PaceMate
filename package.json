{
  "name": "pacemate",
  "version": "3.0.0",
  "description": "Application de running sociale avec carte interactive et mini-jeux",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "client": "python -m http.server 8000",
    "build:client": "node build-production.js",
    "build:css": "cleancss -o public/styles.min.css styles.css",
    "build:js": "terser app.js -o public/app.min.js -c -m",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:edge": "cypress run --browser edge",
    "test": "start-server-and-test start http://localhost:3000 cy:run",
    "test:open": "start-server-and-test start http://localhost:3000 cy:open",
    "test:headed": "cypress run --headed",
    "test:spec": "cypress run --spec",
    "report": "cypress run --reporter mochawesome"
  },
  "keywords": [
    "running",
    "fitness",
    "social",
    "gaming",
    "maps",
    "multiplayer"
  ],
  "author": "PaceMate Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.0",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "cypress": "^13.6.0",
    "start-server-and-test": "^2.0.3",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "clean-css-cli": "^5.6.3",
    "terser": "^5.26.0",
    "eslint": "^8.56.0",
    "eslint-plugin-cypress": "^2.15.1",
    "fs-extra": "^11.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": true
  }
}
